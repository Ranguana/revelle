# Revelle Société — environment
#
# Copy to .env.local for development. NEVER commit the filled-in version;
# .gitignore already excludes .env* except this file.
#
# There are no local fallbacks by design: a missing value fails loudly at the
# point of use rather than quietly working on one machine only. The same rule
# is why migrations run inside Render (see render.yaml) and not from a laptop.

# ── Database ─────────────────────────────────────────────────────────
# REQUIRED. Postgres connection string.
# SSL is inferred from the host: anything that is not localhost/127.0.0.1/[::1]
# gets TLS, because hosted providers reject plaintext connections. Append
# ?sslmode=disable to force it off (the only escape hatch, honoured by both
# src/lib/db.ts and scripts/migrate.mjs).
#
# On Render this is injected from the database's connectionString — do not set
# it by hand there.
DATABASE_URL=postgresql://user:password@host:5432/revelle

# Optional. Pool size per process, default 10. Set it below the database plan's
# connection limit if more than one instance runs.
# DATABASE_POOL_MAX=10

# ── Email (Resend) ───────────────────────────────────────────────────
# REQUIRED for the quiz confirmation. Without them the quiz still saves her
# answers — the submission is never failed by a mail problem — and the send is
# skipped with a warning in the log.
#
# MAIL_FROM must be on a domain verified in the Resend account, or every send
# is rejected with a 4xx.
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM="Revelle Société <hello@revellesociete.com>"

# Optional. Where a customer's reply goes. The confirmation email tells her to
# reply, so this should be an address a human actually reads.
# MAIL_REPLY_TO=studio@revellesociete.com

# ── URLs ─────────────────────────────────────────────────────────────
# The real public origin, no trailing slash. Used for absolute links in
# outbound mail and, later, for a customer's Revelle URL. A wrong value
# produces links that 404 for the recipient.
APP_URL=http://localhost:3000
