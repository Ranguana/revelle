export type FontKey = (typeof FONTS)[number]["key"];

/** Every family, by key. */
export const FONTS_BY_KEY: Record<FontKey, (typeof FONTS)[number]> =
  Object.fromEntries(FONTS.map((f) => [f.key, f])) as Record<
    FontKey,
    (typeof FONTS)[number]
  >;
